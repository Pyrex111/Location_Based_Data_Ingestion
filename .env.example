# Copy to .env and supply your own bucket and OpenCage key.
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-2
OPENCAGE_API_KEY=

# AWS credentials can come from a local AWS profile, environment, or IAM role.
# Optional environment credentials (leave blank when using a profile or role):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
